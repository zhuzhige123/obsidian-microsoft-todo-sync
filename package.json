{
  "name": "obsidian-microsoft-todo-sync",
  "private": true,
  "version": "1.0.5",
  "description": "Selective two-way sync between Obsidian tasks and Microsoft To Do.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "predev": "node scripts/kill-vite.cjs",
    "dev": "node scripts/dev-watch.cjs",
    "dev:stop": "node scripts/kill-vite.cjs",
    "build": "tsc -p tsconfig.json --noEmit && vite build --mode production && node scripts/postbuild.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:obsidian": "eslint src manifest.json LICENSE --config eslint.obsidian.config.mjs",
    "lint:obsidian:community": "node scripts/lint-community-audit.cjs",
    "lint:obsidian:strict": "node scripts/lint-obsidian-strict.cjs",
    "verify:obsidian-community": "npm run lint:obsidian && npm run lint:obsidian:community",
    "verify:community": "npm run verify:obsidian-community && npm test && npm run build",
    "verify:release": "npm run verify:community && npm run lint:obsidian:strict",
    "check:private-push": "node scripts/private-push-guard.mjs",
    "push:private": "node scripts/private-push-guard.mjs && git push origin main",
    "sync:obsidian-community": "node scripts/sync-obsidian-community.mjs",
    "setup:private-remote": "node scripts/setup-private-remote.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "microsoft-todo",
    "tasks",
    "svelte",
    "typescript"
  ],
  "author": "Rabbit (zhuzhige)",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/json": "^0.14.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.30.0",
    "@typescript-eslint/parser": "^8.30.0",
    "eslint": "^9.39.0",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "^1.7.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.6.2",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
